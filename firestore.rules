rules_version = '2';
// Get Started — regras V28 (10/08/2026)
// Login da equipe por Google verificado; Portal/formulários continuam anônimos e isolados.
// IMPORTANTE: publicar junto com escritorio.html V48.
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function temEmailVerificado() {
      return logado() && request.auth.token.email is string &&
        request.auth.token.email_verified == true;
    }
    function emailDaEquipeSemente() {
      return temEmailVerificado() && request.auth.token.email in [
        'christopherveloso0@gmail.com','amandachamorrosm@gmail.com',
        'vitoriaboaron215@gmail.com','gabrielleromaomarketing@gmail.com','yasmocelin@gmail.com',
        'heloisaksc@gmail.com','luissouza280507@gmail.com',
        'nathanocosta652@gmail.com','victorvieiraj814@gmail.com'
      ];
    }
    function emailDaEquipeCadastrado() {
      return temEmailVerificado() &&
        exists(/databases/$(database)/documents/usuarios_equipe/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/usuarios_equipe/$(request.auth.token.email)).data.ativo == true &&
        get(/databases/$(database)/documents/usuarios_equipe/$(request.auth.token.email)).data.excluido != true;
    }
    function emailDaSementeNaoRevogado() {
      return emailDaEquipeSemente() && (
        !exists(/databases/$(database)/documents/usuarios_equipe/$(request.auth.token.email)) ||
        (
          get(/databases/$(database)/documents/usuarios_equipe/$(request.auth.token.email)).data.ativo != false &&
          get(/databases/$(database)/documents/usuarios_equipe/$(request.auth.token.email)).data.excluido != true
        )
      );
    }
    function ehEquipe() {
      return emailDaSementeNaoRevogado() || emailDaEquipeCadastrado();
    }
    function ehGerencia() {
      return temEmailVerificado() && request.auth.token.email in [
        'christopherveloso0@gmail.com','amandachamorrosm@gmail.com'
      ];
    }
    function ehAmanda() {
      return temEmailVerificado() && request.auth.token.email == 'amandachamorrosm@gmail.com';
    }
    function ehChris() {
      return temEmailVerificado() && request.auth.token.email == 'christopherveloso0@gmail.com';
    }
    function ehGabi() {
      return temEmailVerificado() && request.auth.token.email == 'gabrielleromaomarketing@gmail.com';
    }
    function ehCecilia() {
      return temEmailVerificado() && request.auth.token.email == 'vitoriaboaron215@gmail.com';
    }
    function podePrepararLinkCalendario() {
      return temEmailVerificado() && request.auth.token.email in [
        'christopherveloso0@gmail.com','amandachamorrosm@gmail.com',
        'vitoriaboaron215@gmail.com','gabrielleromaomarketing@gmail.com'
      ];
    }
    function temSessaoCliente() {
      return logado() &&
        exists(/databases/$(database)/documents/sessoes_cliente/$(request.auth.uid)) &&
        (
          !('modo' in get(/databases/$(database)/documents/sessoes_cliente/$(request.auth.uid)).data) ||
          get(/databases/$(database)/documents/sessoes_cliente/$(request.auth.uid)).data.modo != 'equipe'
        );
    }
    function temSessaoCalendarioEquipe() {
      return logado() &&
        exists(/databases/$(database)/documents/sessoes_cliente/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/sessoes_cliente/$(request.auth.uid)).data.modo == 'equipe';
    }
    function clienteDaSessao() {
      return get(/databases/$(database)/documents/sessoes_cliente/$(request.auth.uid)).data.cliente;
    }
    function ehMeuDoc() {
      return temSessaoCliente() && resource.data.cliente == clienteDaSessao();
    }
    function meuDocPermaneceMeu() {
      return ehMeuDoc() && request.resource.data.cliente == clienteDaSessao();
    }
    function vouCarimbarCerto() {
      return temSessaoCliente() && request.resource.data.cliente == clienteDaSessao();
    }
    function acessoDentroDaVigencia(dados) {
      return !('ativoAte' in dados) || request.time < dados.ativoAte;
    }
    function tokenPortalValido(cliente, token) {
      return (
        exists(/databases/$(database)/documents/clientes_portal_tokens/$(token)) &&
        get(/databases/$(database)/documents/clientes_portal_tokens/$(token)).data.cliente == cliente &&
        (
          !('ativo' in get(/databases/$(database)/documents/clientes_portal_tokens/$(token)).data) ||
          get(/databases/$(database)/documents/clientes_portal_tokens/$(token)).data.ativo != false
        ) &&
        acessoDentroDaVigencia(get(/databases/$(database)/documents/clientes_portal_tokens/$(token)).data)
      ) || (
        exists(/databases/$(database)/documents/clientes_acesso/$(cliente)) &&
        (
          !('ativo' in get(/databases/$(database)/documents/clientes_acesso/$(cliente)).data) ||
          get(/databases/$(database)/documents/clientes_acesso/$(cliente)).data.ativo != false
        ) &&
        acessoDentroDaVigencia(get(/databases/$(database)/documents/clientes_acesso/$(cliente)).data) &&
        get(/databases/$(database)/documents/clientes_acesso/$(cliente)).data.token == token
      );
    }
    function tokenCalendarioEquipeValido(cliente, token) {
      return exists(/databases/$(database)/documents/clientes_acesso/$(cliente)) &&
        (
          !('ativo' in get(/databases/$(database)/documents/clientes_acesso/$(cliente)).data) ||
          get(/databases/$(database)/documents/clientes_acesso/$(cliente)).data.ativo != false
        ) &&
        acessoDentroDaVigencia(get(/databases/$(database)/documents/clientes_acesso/$(cliente)).data) &&
        get(/databases/$(database)/documents/clientes_acesso/$(cliente)).data.tokenEquipe == token;
    }
    function ehDonoExtra(dados) {
      return temEmailVerificado() && (
        (request.auth.token.email == 'christopherveloso0@gmail.com' && dados.filmmaker == 'Chris') ||
        (request.auth.token.email == 'amandachamorrosm@gmail.com' && dados.filmmaker == 'Amanda') ||
        (request.auth.token.email == 'vitoriaboaron215@gmail.com' && dados.filmmaker == 'Cecília') ||
        (request.auth.token.email == 'gabrielleromaomarketing@gmail.com' && dados.filmmaker == 'Gabrielle') ||
        (request.auth.token.email == 'heloisaksc@gmail.com' && dados.filmmaker == 'Helo') ||
        (request.auth.token.email == 'luissouza280507@gmail.com' && dados.filmmaker == 'Luís') ||
        (request.auth.token.email == 'nathanocosta652@gmail.com' && dados.filmmaker == 'Nathan') ||
        (request.auth.token.email == 'victorvieiraj814@gmail.com' && dados.filmmaker == 'João Victor')
      );
    }

    match /sessoes_equipe/{uid} {
      allow read: if ehEquipe() && request.auth.uid == uid;
      allow create, update, delete: if ehEquipe() && request.auth.uid == uid;
    }
    match /sessoes_gerencia/{uid} {
      allow read: if ehGerencia() && request.auth.uid == uid;
      allow create, update, delete: if ehGerencia() && request.auth.uid == uid;
    }
    match /sessoes_cliente/{uid} {
      allow read, delete: if logado() && request.auth.uid == uid;
      allow create, update: if logado() && request.auth.uid == uid &&
        request.resource.data.cliente is string && request.resource.data.token is string && (
          (('modo' in request.resource.data) && request.resource.data.modo == 'equipe' && tokenCalendarioEquipeValido(request.resource.data.cliente, request.resource.data.token)) ||
          ((!('modo' in request.resource.data) || request.resource.data.modo != 'equipe') && tokenPortalValido(request.resource.data.cliente, request.resource.data.token))
        );
    }

    // O formulário público apenas entrega a ficha; só a gerência lê e ativa.
    match /cadastros_clientes/{docId} {
      allow create: if logado() &&
        request.resource.data.cadastroTipo == 'mensalista_fechado' &&
        request.resource.data.statusGerencia == 'aguardando_validacao' &&
        request.resource.data.privadoGerencia == true;
      allow read: if ehGerencia() || (temSessaoCliente() && resource.data.slug == clienteDaSessao());
      allow update: if ehGerencia();
      allow delete: if false;
    }
    match /leads_avulsos/{docId} {
      allow create: if logado() && request.resource.data.origemLead == 'avulso';
      allow read, update: if ehGerencia();
      allow delete: if false;
    }
    match /leads_mensalista/{docId} {
      allow create: if logado();
      allow read, update: if ehGerencia();
      allow delete: if false;
    }
    match /leads_pessoa_fisica/{docId} {
      allow create: if logado();
      allow read, update: if ehGerencia();
      allow delete: if false;
    }

    match /clientes_portal_tokens/{token} {
      allow get: if logado();
      allow list: if ehGerencia();
      allow create, update: if ehGerencia();
      allow delete: if false;
    }
    match /usuarios_equipe/{email} {
      allow get: if temEmailVerificado() && request.auth.token.email == email;
      allow list, create, update: if ehGerencia();
      allow delete: if false;
    }
    match /emails_equipe/{pessoa} {
      allow read: if ehEquipe();
      allow create, update: if ehGerencia();
      allow delete: if false;
    }
    match /clientes_acesso/{slug} {
      allow get: if ehEquipe();
      allow list: if ehGerencia();
      allow create: if ehGerencia() || (
        podePrepararLinkCalendario() &&
        request.resource.data.keys().hasOnly(['token','tokenEquipe','nome','criadoEm']) &&
        request.resource.data.token is string &&
        request.resource.data.tokenEquipe is string &&
        request.resource.data.nome is string
      );
      allow update: if ehGerencia() || (
        podePrepararLinkCalendario() && (!('ativo' in resource.data) || resource.data.ativo != false) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['token','tokenEquipe','nome','criadoEm']) &&
        (!('token' in resource.data) || request.resource.data.token == resource.data.token) &&
        (!('tokenEquipe' in resource.data) || request.resource.data.tokenEquipe == resource.data.tokenEquipe)
      );
      allow delete: if false;
    }

    match /cofre_senhas/{docId}        { allow read, create, update: if ehGerencia(); allow delete: if false; }
    match /receitas_avulsas/{docId}    { allow read, create, update: if ehGerencia(); allow delete: if false; }
    match /clientes_encerrados/{docId} { allow read, create, update: if ehGerencia(); allow delete: if false; }
    match /onboarding_processos/{docId}{ allow read, create, update: if ehGerencia(); allow delete: if false; }
    match /negocios/{docId} {
      allow read: if ehGerencia() || (temSessaoCliente() && resource.data.clienteSlug == clienteDaSessao());
      allow create: if ehGerencia();
      allow update: if ehGerencia() || (
        temSessaoCliente() && resource.data.clienteSlug == clienteDaSessao() &&
        request.resource.data.clienteSlug == clienteDaSessao() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estagio','respostaCliente','respostaTexto','historico','atualizadoEm',
          'pagamentoComprovante','pagamentoEnviadoEm'
        ]) && (
          request.resource.data.estagio == resource.data.estagio ||
          request.resource.data.estagio in ['aceita','ajuste','perdido']
        )
      );
      allow delete: if false;
    }
    match /contratos_cliente/{slug} {
      allow read: if ehGerencia() || (temSessaoCliente() && slug == clienteDaSessao());
      allow create, update: if ehGerencia();
      allow delete: if false;
    }
    match /pagamentos_mensais/{docId} {
      allow read: if ehGerencia() || ehMeuDoc();
      allow create: if ehGerencia();
      allow update: if ehGerencia() || (meuDocPermaneceMeu() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comprovante','comprovanteEnviadoEm']));
      allow delete: if false;
    }
    // O registro da conta pessoal não fica exposto à Amanda, clientes ou equipe.
    // Amanda pode apenas criar o pendente padronizado durante a ativação; depois
    // somente o Chris lê, classifica a conta e confirma/desfaz o recebimento.
    match /recebimentos_entrada_pessoal/{docId} {
      allow read, update: if ehChris();
      allow create: if ehChris() || (ehAmanda() &&
        request.resource.data.keys().hasOnly([
          'id','cliente','clienteNome','competencia','mensalidadeId','valorPrevisto',
          'status','destino','foraCaixaAgencia','origem','pagoEm','excluido',
          'criadoPor','criadoEm'
        ]) &&
        request.resource.data.id == docId &&
        request.resource.data.cliente is string &&
        request.resource.data.clienteNome is string &&
        request.resource.data.competencia is string &&
        request.resource.data.mensalidadeId is string &&
        request.resource.data.valorPrevisto is number && request.resource.data.valorPrevisto > 0 &&
        request.resource.data.status == 'pendente' &&
        !('destino' in request.resource.data) &&
        !('foraCaixaAgencia' in request.resource.data) &&
        request.resource.data.origem == 'ativacao_mensalista' &&
        request.resource.data.pagoEm == '' &&
        request.resource.data.excluido == false
      );
      allow delete: if false;
    }
    match /pagamentos_extra/{docId} {
      allow read: if ehGerencia() || (ehEquipe() && ehDonoExtra(resource.data));
      allow create: if ehGerencia() || (ehEquipe() && ehDonoExtra(request.resource.data) &&
        request.resource.data.pago == false && request.resource.data.informadoPelaPessoa == true &&
        (!('aprovadoPeloChris' in request.resource.data) || request.resource.data.aprovadoPeloChris != true) &&
        (!('excluido' in request.resource.data) || request.resource.data.excluido != true));
      allow update: if ehGerencia();
      allow delete: if false;
    }
    match /log_acessos/{docId} { allow read: if ehGerencia(); allow create: if logado(); allow update, delete: if false; }
    match /config_seguranca/{docId} { allow read, create, update: if ehGerencia(); allow delete: if false; }

    // Caixa pública separada: o visitante envia; somente a equipe converte em demanda.
    match /pedidos_publicos/{docId} {
      allow create: if logado();
      allow read, update: if ehEquipe();
      allow delete: if false;
    }

    // Dados compartilhados com o Portal: equipe inteira ou somente o cliente da sessão.
    match /calendarios/{slug} {
      allow get: if ehEquipe() || ((temSessaoCliente() || temSessaoCalendarioEquipe()) && slug == clienteDaSessao());
      allow list: if ehEquipe();
      allow create: if ehEquipe() || (temSessaoCalendarioEquipe() && slug == clienteDaSessao());
      allow update: if ehEquipe() || (temSessaoCalendarioEquipe() && slug == clienteDaSessao()) || (temSessaoCliente() && slug == clienteDaSessao() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items','comments','updatedAt','aprovacaoMeses','aprovacaoCliente','aprovacaoInterna']));
      allow delete: if false;
    }
    match /videos_producao/{docId}  { allow read: if ehEquipe() || ehMeuDoc(); allow create: if ehEquipe(); allow update: if ehEquipe() || meuDocPermaneceMeu(); allow delete: if false; }
    match /postagens/{docId}        { allow read: if ehEquipe() || ehMeuDoc(); allow create, update: if ehEquipe(); allow delete: if false; }
    match /agendamentos/{docId}     { allow read: if ehEquipe() || ehMeuDoc(); allow create, update: if ehEquipe(); allow delete: if false; }
    match /atas_reuniao/{docId}     { allow read: if ehEquipe() || ehMeuDoc(); allow create, update: if ehEquipe(); allow delete: if false; }
    match /stories_semanais/{docId} { allow read: if ehEquipe() || ehMeuDoc(); allow create: if ehEquipe() || vouCarimbarCerto(); allow update: if ehEquipe() || meuDocPermaneceMeu(); allow delete: if false; }
    match /demandas_cliente/{docId} {
      allow read: if ehEquipe() || ehMeuDoc();
      allow create: if ehEquipe() || vouCarimbarCerto();
      allow update: if ehEquipe() || meuDocPermaneceMeu();
      allow delete: if false;
    }
    match /checklist_cliente/{docId} {
      allow read: if ehEquipe() || ehMeuDoc();
      allow create: if ehEquipe();
      allow update: if ehEquipe() || meuDocPermaneceMeu();
      allow delete: if false;
    }
    match /ideias_cliente/{docId} {
      allow read: if ehEquipe() || ehMeuDoc();
      allow create: if ehEquipe() || vouCarimbarCerto();
      allow update: if ehEquipe() || meuDocPermaneceMeu();
      allow delete: if false;
    }
    match /referencias_cliente/{docId} {
      allow read: if ehEquipe() || ehMeuDoc();
      allow create: if ehEquipe() || vouCarimbarCerto();
      allow update: if ehEquipe() || meuDocPermaneceMeu();
      allow delete: if false;
    }
    match /avisos_do_cliente/{docId} {
      allow read: if ehEquipe() || ehMeuDoc();
      allow create: if ehEquipe() || vouCarimbarCerto();
      allow update: if ehEquipe() || meuDocPermaneceMeu();
      allow delete: if false;
    }
    match /info_extras_cliente/{slug} {
      allow read: if ehEquipe() || (temSessaoCliente() && slug == clienteDaSessao());
      allow create, update: if ehEquipe() || (temSessaoCliente() && slug == clienteDaSessao());
      allow delete: if false;
    }
    match /clientes_drive/{slug} {
      allow read: if ehEquipe() || (temSessaoCliente() && slug == clienteDaSessao());
      allow create, update: if ehEquipe();
      allow delete: if false;
    }
    match /briefings_cliente/{slug} {
      allow read: if ehEquipe() || (temSessaoCliente() && slug == clienteDaSessao());
      allow create, update: if ehEquipe() || (temSessaoCliente() && slug == clienteDaSessao());
      allow delete: if false;
    }
    match /processos_cliente/{slug} {
      allow read: if ehEquipe() || (temSessaoCliente() && slug == clienteDaSessao());
      allow create, update: if ehEquipe();
      allow delete: if false;
    }
    match /referencias/{docId} {
      allow read: if ehEquipe() || ehMeuDoc();
      allow create, update: if ehEquipe();
      allow delete: if false;
    }
    match /refs_perfil_semana/{slug} {
      allow read: if ehEquipe() || (temSessaoCliente() && slug == clienteDaSessao());
      allow create, update: if ehEquipe();
      allow delete: if false;
    }

    match /clientes_extras/{docId} {
      allow read: if ehEquipe();
      allow create, update: if ehGerencia();
      allow delete: if false;
    }
    match /tipos_tarefa_fixa/{docId} {
      allow read: if ehEquipe();
      allow create, update: if ehAmanda();
      allow delete: if false;
    }
    match /clientes_config/{docId} {
      allow read: if ehEquipe();
      allow create, update: if ehGerencia();
      allow delete: if false;
    }
    match /capsulas_clientes/{docId} {
      allow read, create, update: if ehAmanda();
      allow delete: if false;
    }
    match /campanhas/{docId} {
      allow read: if ehChris() || ehAmanda() || ehGabi() || ehCecilia();
      allow create: if ehChris() || ehGabi();
      allow update: if ehChris() || ehAmanda() || ehGabi() || ehCecilia();
      allow delete: if false;
    }

    // Coleções exclusivamente operacionais. Sem sessão de equipe, não há leitura.
    match /{colecao}/{docId} {
      allow read, create, update: if ehEquipe() && colecao in [
        'agenda_reunioes','anotacoes_pessoais','ausencias','avaliacoes_clientes',
        'calendarios_backup','calendarios_backup_20260727',
        'calendarios_enviados','calendarios_versoes',
        'checklist_execucoes','checklist_templates_custom','config_painel','controle_postagens',
        'demandas','editores_afinidade','email_digest_controle','email_throttle',
        'fila_emails','foto_do_dia','funcionario_do_mes','funcoes_fixas_geradas','get_academy',
        'log_automacoes','metas_equipe','observacoes_funcionarios','presenca_funcionarios',
        'ranking_historico','resumos_diarios',
        'rfv_clientes','sistema','stories_clientes','stories_diarios_config',
        'stories_diarios_execucoes','stories_links'
      ];
      // Dados operacionais nunca são apagados fisicamente. As telas usam
      // `excluido:true`, preservando histórico e permitindo auditoria.
      allow delete: if false;
    }
  }
}
