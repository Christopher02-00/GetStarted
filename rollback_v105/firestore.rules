        request.resource.data.respostaCliente == request.resource.data.estagio &&
        request.resource.data.respostaTexto is string &&
        request.resource.data.respostaTexto.size() <= 2000 &&
        request.resource.data.atualizadoEm == request.time &&
        historicoRespostaClienteValido();
    }
    function contatoFinanceiroValido(slug, dados) {
      return dados.keys().hasOnly([
