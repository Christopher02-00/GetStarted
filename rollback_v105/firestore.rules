    function temSessaoCliente() {
      return logado() &&
        exists(/databases/$(database)/documents/sessoes_cliente/$(request.auth.uid)) &&
        (
          !('modo' in get(/databases/$(database)/documents/sessoes_cliente/$(request.auth.uid)).data) ||
          get(/databases/$(database)/documents/sessoes_cliente/$(request.auth.uid)).data.modo != 'equipe'
