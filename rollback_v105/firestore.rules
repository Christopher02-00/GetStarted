rules_version = '2';
    // Get Started — regras V103 (21/08/2026)
// Login da equipe por Google verificado; Portal/formulários continuam anônimos e isolados.
    // IMPORTANTE: publicar junto com calendario.html, calendarios.html e portal-cliente.html V85.
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function temEmailVerificado() {
      return logado() && request.auth.token.email is string &&
        request.auth.token.email_verified == true;
    }
    function emailDaEquipeSemente() {
      return temEmailVerificado() && request.auth.token.email in [
        'christopherveloso0@gmail.com','amandachamorrosm@gmail.com',
        'vitoriaboaron215@gmail.com','gabrielleromaomarketing@gmail.com','yasmocelin@gmail.com',
        'heloisaksc@gmail.com','luissouza280507@gmail.com',
        'nathanocosta652@gmail.com','victorvieiraj814@gmail.com'
      ];
    }
    function emailDaEquipeCadastrado() {
      return temEmailVerificado() &&
        exists(/databases/$(database)/documents/usuarios_equipe/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/usuarios_equipe/$(request.auth.token.email)).data.ativo == true &&
        get(/databases/$(database)/documents/usuarios_equipe/$(request.auth.token.email)).data.excluido != true;
    }
    function emailDaSementeNaoRevogado() {
      return emailDaEquipeSemente() && (
        !exists(/databases/$(database)/documents/usuarios_equipe/$(request.auth.token.email)) ||
        (
          get(/databases/$(database)/documents/usuarios_equipe/$(request.auth.token.email)).data.ativo != false &&
          get(/databases/$(database)/documents/usuarios_equipe/$(request.auth.token.email)).data.excluido != true
        )
      );
    }
    function ehEquipe() {
      return emailDaSementeNaoRevogado() || emailDaEquipeCadastrado();
    }
    function ehGerencia() {
      return emailDaSementeNaoRevogado() && request.auth.token.email in [
        'christopherveloso0@gmail.com','amandachamorrosm@gmail.com'
      ];
    }
    function ehAmanda() {
      return emailDaSementeNaoRevogado() && request.auth.token.email == 'amandachamorrosm@gmail.com';
    }
    function ehChris() {
      return emailDaSementeNaoRevogado() && request.auth.token.email == 'christopherveloso0@gmail.com';
    }
    function ehGabi() {
      return emailDaSementeNaoRevogado() && request.auth.token.email == 'gabrielleromaomarketing@gmail.com';
    }
    function ehCecilia() {
      return emailDaSementeNaoRevogado() && request.auth.token.email == 'vitoriaboaron215@gmail.com';
    }

    // V103 — núcleo financeiro por competência.
    //
    // O ledger é append-only e usa operationId como identidade determinística.
    // Lançamentos de custos/receitas internas são privados do Chris e toda
    // criação/transição exige o evento correspondente no mesmo commit.
    function competenciaFinanceiraValida(valor) {
      return valor is string && valor.matches('[0-9]{4}-(0[1-9]|1[0-2])');
    }
    function idFinanceiroValido(valor) {
      return valor is string && valor.matches('[A-Za-z0-9][A-Za-z0-9._:-]{0,159}');
    }
    function operationIdFinanceiroValido(valor) {
      return valor is string && valor.matches('fin_[A-Za-z0-9_-]{12,156}');
    }
    function hashFinanceiroValido(valor) {
      return valor is string && valor.matches('[a-f0-9]{64}');
    }
    function textoFinanceiroValido(valor, minimo, maximo) {
      return valor is string && valor.size() >= minimo && valor.size() <= maximo;
    }
    function mensalidadeTemFlagTerminal(dados) {
      return dados.get('cancelado', false) == true || dados.get('cancelada', false) == true ||
        dados.get('encerrado', false) == true || dados.get('encerrada', false) == true ||
        dados.get('excluido', false) == true || dados.get('excluida', false) == true ||
        dados.get('arquivado', false) == true || dados.get('arquivada', false) == true;
    }
    function mensalidadeFinanceiraTerminal(dados) {
      return dados.get('status', '') in [
          'pago','paga','quitado','quitada','recebido','recebida',
          'isento','isenta','cortesia','cancelado','cancelada','encerrado','encerrada',
          'excluido','excluida','arquivado','arquivada','finalizado','finalizada'
        ] || mensalidadeTemFlagTerminal(dados);
    }
    function mensalidadeFinanceiraIsenta(dados) {
      return dados.get('status', '') in ['isento','isenta','cortesia'] &&
        !mensalidadeTemFlagTerminal(dados);
    }
    function mensalidadeFinanceiraAberta(dados) {
      return dados.get('status', '') in ['aberto','aberta','pendente'] &&
        !mensalidadeTemFlagTerminal(dados);
    }
    function mensalidadeTerminalImutavel(antes, depois) {
      return mensalidadeFinanceiraTerminal(antes) &&
        depois.diff(antes).affectedKeys().hasOnly([]);
    }
    function cancelamentoMensalidadePorSaidaValido(antes, depois) {
      return (mensalidadeFinanceiraAberta(antes) || mensalidadeFinanceiraIsenta(antes)) &&
        depois.get('status', '') == 'cancelado' &&
        depois.get('canceladoPorSaida', false) == true &&
        depois.get('canceladoPorSaidaId', '') is string &&
        depois.get('canceladoPorSaidaId', '').size() >= 3 &&
        depois.diff(antes).affectedKeys().hasOnly([
          'status','canceladoPorSaida','canceladoPorSaidaId','statusAntesSaida',
          'motivoCancelamento','canceladoEm','canceladoPor','atualizadoEm','atualizadoPor'
        ]);
    }
    function atualizacaoMensalidadeAbertaValida(antes, depois) {
      return mensalidadeFinanceiraAberta(antes) &&
        !depois.diff(antes).affectedKeys().hasAny([
          'cliente','clienteSlug','canonicalId','competencia',
          'valorDevido','valor','valorCobrado','financeiroOperationId',
          'valorContratoProgramado','valorContratoProgramadoEm',
          'cancelado','cancelada','encerrado','encerrada',
          'excluido','excluida','arquivado','arquivada'
        ]) &&
        depois.get('status', '') in [
          'aberto','aberta','pendente','pago','paga','quitado','quitada',
          'recebido','recebida','isento','isenta','cortesia'
        ];
    }
    function clienteMensalidadeFinanceira(dados) {
      return dados.get('canonicalId', dados.get('cliente', dados.get('clienteSlug', '')));
    }
    function atualizacaoValorMensalidadeProgramadaValida(antes, depois) {
      let alterados = depois.diff(antes).affectedKeys();
      let cliente = clienteMensalidadeFinanceira(depois);
      let contratoAntes = get(/databases/$(database)/documents/contratos_cliente/$(cliente)).data;
      let contratoDepois = getAfter(/databases/$(database)/documents/contratos_cliente/$(cliente)).data;
      return ehChris() &&
        (mensalidadeFinanceiraAberta(antes) || mensalidadeFinanceiraIsenta(antes)) &&
        depois.get('status', '') == antes.get('status', '') &&
        alterados.hasAny(['valorDevido','valor','valorCobrado']) &&
        alterados.hasOnly([
          'valorDevido','valor','valorCobrado','valorContratoProgramado',
          'valorContratoProgramadoEm','financeiroOperationId',
          'clienteNome','diaVencimento','atualizadoPor','atualizadoEm'
        ]) &&
        depois.get('valorDevido', 0) is number && depois.get('valorDevido', 0) > 0 &&
        depois.get('valor', depois.get('valorDevido', 0)) == depois.get('valorDevido', 0) &&
        depois.get('valorCobrado', depois.get('valorDevido', 0)) == depois.get('valorDevido', 0) &&
        depois.get('valorContratoProgramado', false) == true &&
        competenciaFinanceiraValida(depois.get('valorContratoProgramadoEm', '')) &&
        competenciaFinanceiraValida(depois.get('competencia', '')) &&
        depois.get('competencia', '') >= depois.get('valorContratoProgramadoEm', '') &&
        contratoDepois.get('financeiroOperationId', '') == depois.get('financeiroOperationId', '') &&
        contratoAntes.get('financeiroOperationId', '') != depois.get('financeiroOperationId', '') &&
        contratoDepois.get('valorProgramado', 0) == depois.get('valorDevido', 0) &&
        contratoDepois.get('valorProgramadoEm', '') == depois.get('valorContratoProgramadoEm', '') &&
        (!alterados.hasAny(['clienteNome']) || depois.get('clienteNome', '') == contratoDepois.get('clienteNome', '')) &&
        (!alterados.hasAny(['diaVencimento']) || depois.get('diaVencimento', 0) == contratoDepois.get('diaVencimento', 0));
    }
    function reativacaoMensalidadeCanceladaPorSaidaValida(antes, depois) {
      let op = depois.get('financeiroOperationId', '');
      let evento = getAfter(/databases/$(database)/documents/clientes_ciclo_financeiro/$(op)).data;
      return ehChris() &&
        antes.get('status', '') in ['cancelado','cancelada'] &&
        antes.get('canceladoPorSaida', false) == true &&
        depois.get('status', '') in ['isento','isenta','cortesia'] &&
        depois.get('cortesiaDoMes', false) == true &&
        textoFinanceiroValido(depois.get('motivoIsencao', ''), 10, 500) &&
        depois.get('canceladoPorSaida', false) == false &&
        depois.get('canceladoPorSaidaId', '') == '' &&
        operationIdFinanceiroValido(op) &&
        depois.diff(antes).affectedKeys().hasOnly([
          'status','canceladoPorSaida','canceladoPorSaidaId','statusAntesSaida',
          'motivoCancelamento','canceladoEm','canceladoPor','cortesiaDoMes',
          'motivoIsencao','financeiroOperationId','atualizadoEm','atualizadoPor'
        ]) &&
        !exists(/databases/$(database)/documents/clientes_ciclo_financeiro/$(op)) &&
        existsAfter(/databases/$(database)/documents/clientes_ciclo_financeiro/$(op)) &&
        evento.get('operationId', '') == op &&
        evento.get('clienteId', '') == clienteMensalidadeFinanceira(depois) &&
        evento.get('tipo', '') == 'reativacao' &&
        evento.get('sourceType', '') == 'migracao';
    }
    function atualizacaoGerencialMensalidadeValida(antes, depois) {
      let alterados = depois.diff(antes).affectedKeys();
      return mensalidadeFinanceiraAberta(antes)
        ? (alterados.hasAny(['valorDevido','valor','valorCobrado'])
          ? atualizacaoValorMensalidadeProgramadaValida(antes, depois)
          : (atualizacaoMensalidadeAbertaValida(antes, depois) || cancelamentoMensalidadePorSaidaValido(antes, depois)))
        : (mensalidadeFinanceiraIsenta(antes)
          ? (alterados.hasAny(['valorDevido','valor','valorCobrado'])
            ? atualizacaoValorMensalidadeProgramadaValida(antes, depois)
            : (cancelamentoMensalidadePorSaidaValido(antes, depois) || mensalidadeTerminalImutavel(antes, depois)))
          : ((antes.get('status', '') in ['cancelado','cancelada'] &&
              antes.get('canceladoPorSaida', false) == true &&
              reativacaoMensalidadeCanceladaPorSaidaValida(antes, depois)) ||
            mensalidadeTerminalImutavel(antes, depois)));
    }
    function contratoMudouCampoFinanceiro() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'valorCheio','valorVigente','valorProgramado','valorProgramadoEm',
        'valorProgramadoMotivo','valorProgramadoPor','valorProgramadoAtualizadoEm',
        'historicoAlteracoesValor','diaVencimento','financeiroRevision','financeiroOperationId'
      ]);
    }
    function revisaoFinanceiraContratoValida() {
      return ehChris() &&
        request.resource.data.get('financeiroRevision', 0) == resource.data.get('financeiroRevision', 0) + 1 &&
        operationIdFinanceiroValido(request.resource.data.get('financeiroOperationId', '')) &&
        request.resource.data.get('financeiroOperationId', '') != resource.data.get('financeiroOperationId', '');
    }
    function contratoTemLedgerAtomico(slug) {
      let op = request.resource.data.get('financeiroOperationId', '');
      let evento = getAfter(/databases/$(database)/documents/clientes_ciclo_financeiro/$(op)).data;
      let mudouProgramacao = request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'valorProgramado','valorProgramadoEm','valorProgramadoMotivo'
      ]);
      return !exists(/databases/$(database)/documents/clientes_ciclo_financeiro/$(op)) &&
        existsAfter(/databases/$(database)/documents/clientes_ciclo_financeiro/$(op)) &&
        evento.get('operationId', '') == op &&
        evento.get('sourceType', '') == 'contrato' &&
        evento.get('sourceId', '') == slug &&
        (mudouProgramacao
          ? (evento.get('tipo', '') == 'alteracao_valor' &&
            evento.get('valor', null) == request.resource.data.get('valorProgramado', null) &&
            evento.get('competenciaInicio', '') == request.resource.data.get('valorProgramadoEm', ''))
          : (evento.get('tipo', '') == 'ajuste' && evento.get('valor', null) == null));
    }
    function ledgerFinanceiroValido(operationId, dados) {
      return dados.keys().hasOnly([
          'schemaVersion','operationId','clienteId','tipo','competenciaInicio',
          'ultimaCompetencia','dataEfetiva','valor','sourceType','sourceId',
          'reversalOf','preHash','postHash','criadoPor','criadoEm'
        ]) &&
        dados.keys().hasAll([
          'schemaVersion','operationId','clienteId','tipo','competenciaInicio',
          'ultimaCompetencia','dataEfetiva','valor','sourceType','sourceId',
          'reversalOf','preHash','postHash','criadoPor','criadoEm'
        ]) &&
        dados.schemaVersion == 1 &&
        dados.operationId == operationId &&
        operationIdFinanceiroValido(dados.operationId) &&
        idFinanceiroValido(dados.clienteId) &&
        dados.tipo in [
          'entrada','saida','reativacao','alteracao_valor','lancamento',
          'baixa','cancelamento','reversao','ajuste','deduplicacao'
        ] &&
        competenciaFinanceiraValida(dados.competenciaInicio) &&
        (dados.ultimaCompetencia == null || competenciaFinanceiraValida(dados.ultimaCompetencia)) &&
        dados.dataEfetiva is timestamp &&
        (dados.valor == null || (dados.valor is number && dados.valor > 0 && dados.valor <= 1000000000)) &&
        dados.sourceType in [
          'cadastro','contrato','cliente_encerrado','financeiro_lancamento',
          'ajuste_manual','migracao'
        ] &&
        idFinanceiroValido(dados.sourceId) &&
        (
          (
            dados.tipo == 'reversao' &&
            operationIdFinanceiroValido(dados.reversalOf) &&
            dados.reversalOf != dados.operationId &&
            exists(/databases/$(database)/documents/clientes_ciclo_financeiro/$(dados.reversalOf))
          ) ||
          (dados.tipo != 'reversao' && dados.reversalOf == null)
        ) &&
        hashFinanceiroValido(dados.preHash) &&
        hashFinanceiroValido(dados.postHash) &&
        dados.preHash != dados.postHash &&
        dados.criadoPor == request.auth.uid &&
        dados.criadoEm == request.time;
    }
    function lancamentoFinanceiroValido(docId, dados) {
      return dados.keys().hasOnly([
          'schemaVersion','competencia','tipo','descricao','valor','status',
          'dataCaixa','beneficiarioRef','observacao','autorUid','criadoEm',
          'atualizadoEm','revision','operationId'
        ]) &&
        dados.keys().hasAll([
          'schemaVersion','competencia','tipo','descricao','valor','status',
          'dataCaixa','beneficiarioRef','observacao','autorUid','criadoEm',
          'atualizadoEm','revision','operationId'
        ]) &&
        idFinanceiroValido(docId) &&
        dados.schemaVersion == 1 &&
        competenciaFinanceiraValida(dados.competencia) &&
        dados.tipo in [
          'custo_fixo','salario','imposto','despesa_operacional','receita_ajuste'
        ] &&
        textoFinanceiroValido(dados.descricao, 3, 120) &&
        dados.valor is number && dados.valor > 0 && dados.valor <= 1000000000 &&
        dados.status in ['previsto','pago','cancelado'] &&
        (
          (dados.status == 'previsto' && dados.dataCaixa == null) ||
          (dados.status == 'pago' && dados.dataCaixa is timestamp) ||
          (dados.status == 'cancelado' && (dados.dataCaixa == null || dados.dataCaixa is timestamp))
        ) &&
        idFinanceiroValido(dados.beneficiarioRef) &&
        textoFinanceiroValido(dados.observacao, 0, 500) &&
        dados.autorUid == request.auth.uid &&
        dados.criadoEm is timestamp &&
        dados.atualizadoEm is timestamp &&
        dados.revision is int && dados.revision >= 1 && dados.revision <= 1000000 &&
        operationIdFinanceiroValido(dados.operationId);
    }
    function ledgerCombinaLancamento(docId, lancamento, evento) {
      return evento.sourceType == 'financeiro_lancamento' &&
        evento.sourceId == docId &&
        evento.operationId == lancamento.operationId &&
        evento.clienteId == lancamento.beneficiarioRef &&
        evento.competenciaInicio == lancamento.competencia &&
        evento.valor == lancamento.valor &&
        evento.criadoPor == lancamento.autorUid &&
        evento.criadoEm == lancamento.atualizadoEm;
    }
    function tipoLedgerCombinaTransicaoLancamento(docId, lancamento, evento) {
      return (
          !exists(/databases/$(database)/documents/financeiro_lancamentos/$(docId)) &&
          evento.tipo == 'lancamento' && evento.reversalOf == null
        ) || (
          exists(/databases/$(database)/documents/financeiro_lancamentos/$(docId)) &&
          get(/databases/$(database)/documents/financeiro_lancamentos/$(docId)).data.status == 'previsto' &&
          lancamento.status == 'pago' && evento.tipo == 'baixa' && evento.reversalOf == null
        ) || (
          exists(/databases/$(database)/documents/financeiro_lancamentos/$(docId)) &&
          get(/databases/$(database)/documents/financeiro_lancamentos/$(docId)).data.status == 'previsto' &&
          lancamento.status == 'cancelado' && evento.tipo == 'cancelamento' && evento.reversalOf == null
        ) || (
          exists(/databases/$(database)/documents/financeiro_lancamentos/$(docId)) &&
          get(/databases/$(database)/documents/financeiro_lancamentos/$(docId)).data.status == 'pago' &&
          lancamento.status == 'cancelado' && evento.tipo == 'reversao' &&
          evento.reversalOf == get(/databases/$(database)/documents/financeiro_lancamentos/$(docId)).data.operationId
        ) || (
          exists(/databases/$(database)/documents/financeiro_lancamentos/$(docId)) &&
          lancamento.status == get(/databases/$(database)/documents/financeiro_lancamentos/$(docId)).data.status &&
          evento.tipo == 'ajuste' && evento.reversalOf == null
        );
    }
    function lancamentoTemLedgerAtomico(docId, dados) {
      return !exists(/databases/$(database)/documents/clientes_ciclo_financeiro/$(dados.operationId)) &&
        existsAfter(/databases/$(database)/documents/clientes_ciclo_financeiro/$(dados.operationId)) &&
        ledgerCombinaLancamento(
          docId,
          dados,
          getAfter(/databases/$(database)/documents/clientes_ciclo_financeiro/$(dados.operationId)).data
        ) &&
        tipoLedgerCombinaTransicaoLancamento(
          docId,
          dados,
          getAfter(/databases/$(database)/documents/clientes_ciclo_financeiro/$(dados.operationId)).data
        );
    }
    function ledgerLancamentoTemPrincipalAtomico(dados) {
      return dados.sourceType != 'financeiro_lancamento' || (
        existsAfter(/databases/$(database)/documents/financeiro_lancamentos/$(dados.sourceId)) &&
        ledgerCombinaLancamento(
          dados.sourceId,
          getAfter(/databases/$(database)/documents/financeiro_lancamentos/$(dados.sourceId)).data,
          dados
        ) &&
        tipoLedgerCombinaTransicaoLancamento(
          dados.sourceId,
          getAfter(/databases/$(database)/documents/financeiro_lancamentos/$(dados.sourceId)).data,
          dados
        )
      );
    }
    function ledgerContratoTemPrincipalAtomico(dados) {
      return dados.sourceType != 'contrato' || (
        exists(/databases/$(database)/documents/contratos_cliente/$(dados.sourceId)) &&
        existsAfter(/databases/$(database)/documents/contratos_cliente/$(dados.sourceId)) &&
        getAfter(/databases/$(database)/documents/contratos_cliente/$(dados.sourceId)).data.get('financeiroOperationId', '') == dados.operationId &&
        get(/databases/$(database)/documents/contratos_cliente/$(dados.sourceId)).data.get('financeiroOperationId', '') != dados.operationId &&
        getAfter(/databases/$(database)/documents/contratos_cliente/$(dados.sourceId)).data.get('financeiroRevision', 0) ==
          get(/databases/$(database)/documents/contratos_cliente/$(dados.sourceId)).data.get('financeiroRevision', 0) + 1
      );
    }
    function transicaoLancamentoValida(antes, depois) {
      return (
          antes.status == 'previsto' && depois.status == 'pago' &&
          depois.dataCaixa is timestamp
        ) || (
          antes.status == 'previsto' && depois.status == 'cancelado' &&
          depois.dataCaixa == null && depois.observacao.size() >= 3
        ) || (
          antes.status == 'pago' && depois.status == 'cancelado' &&
          depois.dataCaixa == antes.dataCaixa && depois.observacao.size() >= 3
        ) || (
          depois.status == antes.status &&
          depois.dataCaixa == antes.dataCaixa &&
          depois.observacao != antes.observacao
        );
    }

    // V101 — Controle de conclusão dos calendários.
    //
    // Estas funções protegem somente a projeção administrativa. Elas não
    // autorizam captação, vídeo, postagem nem alteração do calendário. A regra
    // consegue provar identidade, autoria, transição e atomicidade, mas não
    // consegue procurar itemId dentro do array do calendário; essa verificação
    // também é refeita pelo frontend dentro da transação.
    function podeLerControleConclusao() {
      return ehCecilia() || ehChris();
    }
    function idControleValido(valor) {
      return valor is string && valor.size() > 0 && valor.size() <= 500;
    }
    function competenciaControleValida(valor) {
      return valor is string && valor.matches('[0-9]{4}-(0[1-9]|1[0-2])');
    }
    function operationIdControleValido(valor) {
      return valor is string && valor.matches('[A-Za-z0-9_-]{12,160}');
    }
    function assinaturaSha256Valida(valor) {
      return valor is string && valor.matches('[a-f0-9]{64}');
    }
    function observacaoConferenciaValida(valor) {
      return valor is string && valor.size() <= 500;
    }
    function motivoEncerramentoValido(valor) {
      return valor is string && valor.size() >= 10 && valor.size() <= 500;
    }
    function identidadeControleValida(calendarId, competencia, itemId, dados) {
      return idControleValido(calendarId) &&
        competenciaControleValida(competencia) &&
        idControleValido(itemId) &&
        dados.calendarId == calendarId &&
        dados.competencia == competencia &&
        dados.itemId == itemId;
    }
    function autorConferenciaValido(dados) {
      return dados.autorUid == request.auth.uid &&
        dados.papelOperado == 'Cecília' &&
        (
          (dados.atorRealPapel == 'Cecília' && ehCecilia()) ||
          (dados.atorRealPapel == 'Chris' && ehChris())
        );
    }
    function autorEncerramentoValido(dados) {
      return dados.autorUid == request.auth.uid &&
        dados.atorRealPapel == 'Chris' &&
        dados.papelOperado == 'Chris' &&
        ehChris();
    }
    function conferenciaPrincipalValida(calendarId, competencia, itemId, dados) {
      return dados.keys().hasOnly([
          'schemaVersion','calendarId','competencia','itemId','conferido',
          'observacao','fonteAssinatura','revision','operationId','autorUid',
          'atorRealPapel','papelOperado','conferidoEm','atualizadoEm'
        ]) &&
        dados.keys().hasAll([
          'schemaVersion','calendarId','competencia','itemId','conferido',
          'observacao','fonteAssinatura','revision','operationId','autorUid',
