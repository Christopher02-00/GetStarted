          'criadoPor','criadoEm','migracaoVersao','migradoPor','migradoEm','reciboMigracao'
        ]) &&
        dados.slug == slug &&
        dados.whatsapp is string && dados.whatsapp.matches('55[0-9]{10,11}') &&
        (!('nome' in dados) || (dados.nome is string && dados.nome.size() <= 200)) &&
        dados.origem is string &&
